# Pusula pilot sunucusu ayarları. Bu dosyayı .env olarak kopyalayın; .env GitHub'a GÖNDERİLMEZ.
# Ayrıntı: docs/PILOT_KURULUM.md

# --- Adres -----------------------------------------------------------------
# Kullanıcıların tarayıcıda açacağı adres (alan adının kökü, https)
APP_URL=https://pusula.sirketiniz.com.tr/
PORT=8080

# --- İlk yöneticiler ve çalışma alanı ---------------------------------------
# Virgülle ayrılmış e-posta adresleri. İlk açılışta bu kişiler için bir çalışma alanı oluşturulur.
PUSULA_ADMINS=ad.soyad@sirketiniz.com.tr
PUSULA_WORKSPACE_NAME=Depo Pilotu

# --- Microsoft girişi (Entra ID uygulama kaydı) ------------------------------
AUTH_MODE=entra
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
SESSION_HOURS=10
# Bu kadar dakika işlem yapılmayan oturum kapanır
SESSION_IDLE_MINUTES=120
# İşlere eklenen dosyaların azami boyutu (MB, 1–5)
MAX_FILE_MB=5

# --- Outlook e-posta bildirimleri (docs/OUTLOOK_BILDIRIMLERI.md) -------------
# off: e-posta yok · outlook: Microsoft Graph ile gönder (aynı uygulama kaydı kullanılır)
MAIL_MODE=off
MAIL_SENDER=pusula@sirketiniz.com.tr
MAIL_ALLOWED_DOMAINS=sirketiniz.com.tr
# Sabah özeti e-postası: hafta içi bu saatte (Türkiye saati, 5–11). Kapatmak için: off
DIGEST_HOUR=8

# --- Veri ve yedek -----------------------------------------------------------
# Docker'da /data bir birime (volume) bağlıdır. Yedekler her açılışta ve 24 saatte bir alınır.
DATA_DIR=/data
BACKUP_KEEP=14
