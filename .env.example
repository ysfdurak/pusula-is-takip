# Pusula pilot sunucusu ayarları. Bu dosyayı .env olarak kopyalayın; .env GitHub'a GÖNDERİLMEZ.
# Ayrıntı: docs/PILOT_KURULUM.md

# --- Adres -----------------------------------------------------------------
# Kullanıcıların tarayıcıda açacağı adres (alan adının kökü, https)
APP_URL=https://pusula.sirketiniz.com.tr/
PORT=8080

# --- İlk yöneticiler ve çalışma alanı ---------------------------------------
# Virgülle ayrılmış e-posta adresleri. İlk açılışta bu kişiler için bir çalışma alanı oluşturulur.
PUSULA_ADMINS=ad.soyad@sirketiniz.com.tr
PUSULA_WORKSPACE_NAME=Depo Pilotu

# --- Giriş -------------------------------------------------------------------
# entra: Microsoft hesabı (şirket) · google: Google hesabı (portföy/demo, docs/SUNUCU_KURULUMU.md)
AUTH_MODE=entra
# Microsoft (Entra ID uygulama kaydı)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Google (Google Cloud Console → API'ler ve Hizmetler → Kimlik bilgileri → OAuth istemci kimliği, Web uygulaması)
# Yetkili yönlendirme URI'si: <APP_URL>auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# İsteğe bağlı: yalnızca bu alan adlarındaki Google hesapları (ör. şirketin Google Workspace alanı)
GOOGLE_ALLOWED_DOMAINS=
SESSION_HOURS=10
# Bu kadar dakika işlem yapılmayan oturum kapanır
SESSION_IDLE_MINUTES=120
# İşlere eklenen dosyaların azami boyutu (MB, 1–5)
MAX_FILE_MB=5

# --- Outlook e-posta bildirimleri (docs/OUTLOOK_BILDIRIMLERI.md) -------------
# off: e-posta yok · outlook: Microsoft Graph ile gönder (aynı uygulama kaydı kullanılır)
MAIL_MODE=off
MAIL_SENDER=pusula@sirketiniz.com.tr
MAIL_ALLOWED_DOMAINS=sirketiniz.com.tr
# Sabah özeti e-postası: hafta içi bu saatte (Türkiye saati, 5–11). Kapatmak için: off
DIGEST_HOUR=8

# --- Veri ve yedek -----------------------------------------------------------
# Docker'da /data bir birime (volume) bağlıdır. Yedekler her açılışta ve 24 saatte bir alınır.
DATA_DIR=/data
BACKUP_KEEP=14

# --- Ziyaretçi demo alanları (portföy sunucusu; docs/SUNUCU_KURULUMU.md) ------
# true: Pusula'ya üye olmayan biri (Google ile) girince kendine ait, örnek verili, süreli bir alan açılır.
# Şirket kurulumunda KAPALI kalmalı. AUTH_MODE=entra ile birlikte kullanılamaz.
DEMO_MODE=false
# Demo alanı kaç gün sonra tümüyle silinsin (1-30) ve aynı anda en fazla kaç alan olsun
DEMO_TTL_DAYS=7
DEMO_MAX_SANDBOXES=300
# Demo kullanım ölçümü (yalnızca demo ziyaretçileri, takma kimlikle) kaç gün tutulsun (7-730). Özet: /yonetim/istatistik
ANALYTICS_RETENTION_DAYS=180

# --- MCP kapısı: Claude ve diğer yapay zekâ istemcileri (docs/MCP.md) ---------
# Varsayılan kapalı. Şirket verisinin yapay zekâ araçlarına bağlanmaması gereken kurulumlarda KAPALI bırakın.
# Açıkken Claude, kullanıcının normal girişiyle (yukarıdaki AUTH_MODE) OAuth izni alarak bağlanır; ek ayar gerekmez.
MCP_ENABLED=false
# İsteğe bağlı, yalnızca deneme (MCP Inspector): kişisel erişim anahtarları "eposta:anahtar", en az 32 karakter
# MCP_TOKENS=deniz@sirketiniz.com.tr:buraya-64-karakterlik-anahtar
